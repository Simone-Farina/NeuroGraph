# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Only required for local E2E/test helper utilities (not required by app runtime)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── AI Model Configuration ───────────────────────────────────────────────────
# Each agent role has its own model, configured independently.
# Format: provider:model-name   (e.g. openai:gpt-4o-mini, openrouter:anthropic/claude-3.5-sonnet)
# Supported providers: openai | anthropic | google | openrouter
#
# Set AI_PROVIDER=mock to bypass all AI calls with test stubs (local dev / CI).
AI_PROVIDER=

# conversationalist — streaming chat assistant with RAG and Socratic depth guidance
AI_MODEL_CHAT=openai:gpt-4o

# bloomEvaluator — background Bloom's Taxonomy classifier (cost-optimized)
AI_MODEL_EVALUATOR=google:gemini-2.5-flash

# synthesizer — fast in-place content editing and distillation tasks
AI_MODEL_SYNTHESIZER=openai:gpt-4o-mini

# inquisitor — heavier reasoning model for neurogenesis, prerequisite inference, and curriculum design
AI_MODEL_INQUISITOR=openrouter:anthropic/claude-3.5-sonnet
# ──────────────────────────────────────────────────────────────────────────────

# API Keys — only the keys for providers you configure above are required
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key-here
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Langfuse Observability ───────────────────────────────────────────────────
# Required for LLM tracing (all AI calls are observed)
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
# Optional — defaults to Langfuse Cloud (https://cloud.langfuse.com) if omitted
# LANGFUSE_BASEURL=https://cloud.langfuse.com

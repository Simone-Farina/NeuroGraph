# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Only required for local E2E/test helper utilities (not required by app runtime)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── AI Model Configuration ───────────────────────────────────────────────────
# Each agent role has its own model, configured independently.
# Format: provider:model-name
# Supported providers: openai | anthropic | google | openrouter
#
# OpenRouter format: openrouter:anthropic/claude-sonnet-4.5
# OpenRouter lets you access all providers through a single API key.
#
# Set AI_PROVIDER=mock to bypass all AI calls with test stubs (local dev / CI).
AI_PROVIDER=

# Chat assistant — Socratic conversationalist (streaming)
AI_MODEL_CHAT=openrouter:anthropic/claude-sonnet-4.5

# Synthesizer — distills conversation into canonical neuron (cheap, fast)
AI_MODEL_SYNTHESIZER=openrouter:google/gemini-2.5-flash

# Inquisitor — prerequisite inference + Architect (heavier model)
AI_MODEL_INQUISITOR=openrouter:anthropic/claude-sonnet-4.6

# Evaluator — Bloom cognitive depth classification (cheap, fast)
AI_MODEL_EVALUATOR=openrouter:google/gemini-2.5-flash
# ──────────────────────────────────────────────────────────────────────────────

# ─── API Keys ────────────────────────────────────────────────────────────────
# If using OpenRouter: only OPENROUTER_API_KEY is needed (covers all providers)
# If using providers directly: set the keys for providers you configure above
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GOOGLE_API_KEY=your-google-api-key-here

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Langfuse Observability ───────────────────────────────────────────────────
# Required for LLM tracing (all AI calls are observed)
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
# Optional — defaults to Langfuse Cloud (https://cloud.langfuse.com) if omitted
# LANGFUSE_BASEURL=https://cloud.langfuse.com

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "confidence", "match_title", "rationale"],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["append_to_existing", "allow_new"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "match_title": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    }
  }
}
